# Frontend Environment Variables

# Backend API URL (for Render or other deployment)
# For local development, leave this commented out and it will use localhost:5000
# For Render deployment, set this to your Render backend URL
# Example: REACT_APP_API_URL=https://your-backend.onrender.com

# Development (uncomment if needed):
# REACT_APP_API_URL=http://localhost:5000

# Production (Render example):
# REACT_APP_API_URL=https://your-app-name.onrender.com
